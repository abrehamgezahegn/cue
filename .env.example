# Copy to .env.local. Every value is optional; with none set, Cue uses Ollama on this machine.

# Cloud model through DeepInfra. Leave empty to use only local Ollama models.
DEEPINFRA_API_KEY=
DEEPINFRA_MODEL=deepseek-ai/DeepSeek-V4-Flash
# The picker's DeepInfra models, comma-separated. Empty keeps the built-in list.
DEEPINFRA_MODELS=

# Where Ollama listens.
OLLAMA_URL=http://127.0.0.1:11434

# Let yt-dlp use your browser's YouTube cookies (chrome, chromium, safari, firefox, edge, brave),
# or a cookies.txt file. A signed-in client is refused far less often than an anonymous one.
CUE_COOKIES_FROM=
CUE_COOKIES_FILE=

# Overrides: a yt-dlp binary elsewhere, a different transcript cache folder.
CUE_YTDLP=
CUE_CACHE_DIR=

# Log quiz seeds, rejections and audit results to stderr. Set to "full" for longer excerpts.
CUE_DEBUG_QUIZ=
